# Copy this file to .env next to the app (or in backend/, or %APPDATA%\GSTClientApp)
# Restart GST Office after changing it.

STAFF_ACCESS_ENABLED=false

GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=PASTE_YOUR_GOOGLE_CLIENT_SECRET

# Add BOTH of these as Authorized redirect URIs in Google Cloud Console
# (OAuth client ID -> Authorized redirect URIs):
#   http://127.0.0.1:8077/api/auth/google/callback
#   http://127.0.0.1:8077/api/sync/google/callback
# Override only if your app runs on a different address:
# GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:8077/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8077/api/sync/google/callback
